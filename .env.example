# Copy to .env and fill in. Never commit the real .env.

# --- Frontier API (response generation) ---
ANTHROPIC_API_KEY=sk-ant-...
RESPONSE_DEFAULT_MODEL=claude-sonnet-5
RESPONSE_ESCALATED_MODEL=claude-opus-5

# --- Postgres + pgvector ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assistant_memory
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
EMBED_DIM=1024

# --- Kuzu (embedded graph — path inside the assistant container) ---
KUZU_DB_PATH=/data/kuzu/assistant_graph

# --- vLLM (consolidation/reflection pass — pin to the RTX 3090) ---
VLLM_BASE_URL=http://vllm:8000/v1
# Verify the exact current HF repo id/revision before first run.
CONSOLIDATION_MODEL_HF_REPO=mistralai/Mistral-Small-3.2-24B-Instruct-2506
CONSOLIDATION_MODEL_NAME=consolidation-model

# --- Ollama (per-turn extraction + embeddings — pin to the GTX 1080 Ti) ---
OLLAMA_HOST=http://ollama:11434
# Verify exact current tags against ollama.com/library/qwen3 and
# ollama.com/library/qwen3-embedding before pulling.
EXTRACTION_MODEL=qwen3:7b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- GPU pinning — verify against `nvidia-smi -L` before first run ---
VLLM_GPU_DEVICE_ID=0
OLLAMA_GPU_DEVICE_ID=1
